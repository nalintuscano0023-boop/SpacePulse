# SpacePulse Environment Variables
# Frontend-only public configuration.
#
# SECURITY:
# VITE_* variables are bundled into client-side JavaScript.
# NEVER put private API keys, tokens, passwords, credentials,
# client secrets, or private keys in VITE_* variables.

# Public NOAA SWPC endpoint
VITE_NOAA_SWPC_URL=https://services.swpc.noaa.gov

# Public CelesTrak endpoint
VITE_CELESTRAK_URL=https://celestrak.org
